---
const { title, url, description, type, year, status, coverImage, coverVideo } = Astro.props;
const hasCover = Boolean(coverImage || coverVideo);
---
<article class="project-card">
  <a
    class:list={['project-card-link', hasCover ? 'project-card-link-with-image' : 'project-card-link-without-image']}
    href={url}
  >
    {hasCover && (
      <div class="project-card-media">
        {coverVideo ? (
          <video
            src={coverVideo}
            poster={coverImage}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          ></video>
        ) : (
          <img src={coverImage} alt="" loading="lazy" />
        )}
      </div>
    )}
    <span class="project-card-arrow" aria-hidden="true">↗</span>
    <div class="project-card-content">
      <div class="project-card-meta">
        {type && <span>{type}</span>}
        {year && <span>{year}</span>}
      </div>
      <h2>{title}</h2>
      {description && <p>{description}</p>}
      {status && <span class="project-status">{status}</span>}
    </div>
  </a>
</article>
