---
const pageTitle = "Semyon Skotnikov";
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '../styles/index.css';
import '../styles/portfolio.css';
import Sidebar from '../components/Sidebar.astro';
import BlogPost from '../components/BlogPost.astro';
import Analytics from '../components/Analytics.astro';
import { projects } from '../data/projects';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/website-icon.png?v=20260803" />
    <link rel="apple-touch-icon" href="/website-icon.png?v=20260803" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <Analytics />
    <style is:inline>
      .hero-copy::before,
      .page-heading::before {
        content: none !important;
        display: none !important;
      }
    </style>
  </head>
  <body>
    <div class="portfolio-shell">
      <Sidebar />
      <main class="portfolio-scroll portfolio-projects" aria-label="Selected projects">
        <h1 class="visually-hidden">Semyon Skotnikov — selected projects</h1>
        <section class="projects-grid">
          {projects.map((project) => (
            <BlogPost
              url={`/projects/${project.slug}`}
              title={project.title}
              description={project.description}
              type={project.type}
              year={project.year}
              coverImage={project.coverImage}
            />
          ))}
        </section>
      </main>
    </div>
  </body>
</html>
